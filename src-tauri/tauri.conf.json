{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OutFit Mapper",
  "version": "0.1.0",
  "identifier": "com.apolo.outfitmapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "OutFit Mapper",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
